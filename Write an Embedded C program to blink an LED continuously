// Write an Embedded C program to blink an LED continuously

#include <reg51.h>

// Define LED connected to Port 2 Pin 0
sbit led = P2^0;

// Delay function
void delay()
{
    int i, j;

    // Generate delay using nested loops
    for(i = 0; i < 1000; i++)
    {
        for(j = 0; j < 1000; j++);
    }
}

// Main function
void main()
{
    while(1)
    {
        led = 0;   // LED ON (Active LOW)
        delay();

        led = 1;   // LED OFF
        delay();
    }
}
